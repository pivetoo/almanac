# Vhost do host VPS para o Almanac (almanac.mainstay.com.br).
# Caminho: /etc/nginx/sites-available/almanac.mainstay.com.br
#
# Comeca so com a porta 80 e o desafio ACME. Depois que o DNS apontar para a VPS, o certbot
# acrescenta o bloco 443 e o redirect:
#   certbot --nginx -d almanac.mainstay.com.br

server {
    listen 80;
    listen [::]:80;
    server_name almanac.mainstay.com.br;

    client_max_body_size 5m;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://127.0.0.1:8116;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # O MCP responde em JSON simples; sem buffering extra para nao atrasar respostas.
        proxy_buffering off;
    }
}
